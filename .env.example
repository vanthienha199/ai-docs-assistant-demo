# Which answer backend to use: extractive | anthropic | claude_cli
# extractive needs no key and quotes the best passage. Good for a first run.
ASSISTANT_BACKEND=extractive

# Needed only when ASSISTANT_BACKEND=anthropic
ANTHROPIC_API_KEY=sk-ant-replace-me
ASSISTANT_MODEL=claude-haiku-4-5-20251001

# Folder of .md files to index
ASSISTANT_DOCS=documents
